<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="CS-330L Lab Assignment"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnIntentDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Q1: Home to Login (Intent)" />

        <Button
            android:id="@+id/btnQuestion2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Q2: Linear Layout and Toast" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Q3: Settings ListView Adapter" />

        <Button
            android:id="@+id/btnCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Q4: Counter" />

        <Button
            android:id="@+id/btnForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Q5: Details Form and Next Activity" />

    </LinearLayout>
</ScrollView>
